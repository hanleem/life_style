PA_DATA_DIR=./data
# 세션 서명 비밀값: python -c "import secrets;print(secrets.token_urlsafe(32))"
PA_SESSION_SECRET=
PA_ALLOWED_TAILSCALE_LOGIN=
PA_DEV_SKIP_TAILSCALE=false
# tailscale serve 의 tailnet 호스트명(쉼표 구분). 없으면 휴대폰 접속이 403 (루프백 이름은 항상 허용)
PA_ALLOWED_HOSTS=
# AI: OpenAI Codex CLI(본인 ChatGPT 로그인). 설치 스크립트가 경로를 찾아 넣는다
PA_CODEX_BIN=codex
PA_APPROVAL_TTL_MINUTES=30
# Google 캘린더 연결(선택)
PA_GOOGLE_TOKEN_KEY=
PA_GOOGLE_CLIENT_SECRET_PATH=client_secret.json

# 백업 키: uv run python -m pa.backup genkey 로 만든 값. 잃으면 백업을 열 수 없음. 비어 있으면 자동 백업이 꺼진다.
PA_BACKUP_KEY=
PA_BACKUP_DIR=
PA_BACKUP_MIRROR_DIR=
PA_BACKUP_INCLUDE_GOOGLE_TOKEN=false
PA_BACKUP_MAX_MB=1024
